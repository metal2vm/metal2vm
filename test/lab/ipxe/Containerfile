# LAB TOOL: an iPXE boot CD with an embedded script that chainloads metal2vm's
# per-MAC PXE endpoint, standing in for DHCP-based PXE in the lab. Packaged as
# a KubeVirt containerDisk (/disk/ipxe.iso). iPXE is GPL-2.0; this image is
# for testing only and is not shipped with metal2vm.
FROM registry.fedoraproject.org/fedora:44 AS build
ARG IPXE_COMMIT=cb2378d6dc43dfabaf31eb9ddec93166d6e9fa60
ARG BOOT_HOST
RUN dnf -y install --setopt=install_weak_deps=False gcc make perl xz-devel mtools xorriso syslinux git-core && dnf clean all
RUN git clone https://github.com/ipxe/ipxe.git /ipxe && git -C /ipxe checkout "${IPXE_COMMIT}"
RUN printf '#!ipxe\necho metal2vm lab PXE: asking %s\ndhcp\nchain http://%s/boot/v1/pxe-mac/${net0/mac} || shell\n' "${BOOT_HOST}" "${BOOT_HOST}" > /boot.ipxe && cat /boot.ipxe && \
    make -C /ipxe/src -j4 bin/ipxe.iso EMBED=/boot.ipxe NO_WERROR=1 >/dev/null

FROM registry.access.redhat.com/ubi9/ubi-micro
COPY --from=build /ipxe/src/bin/ipxe.iso /disk/ipxe.iso

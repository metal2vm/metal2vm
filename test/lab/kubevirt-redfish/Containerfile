# LAB TOOL: Redfish BMC emulator for KubeVirt VMs (metal2vm end-to-end tests).
ARG BASE_IMAGE=docker.io/library/golang:1.27
FROM ${BASE_IMAGE} AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY api api
COPY internal internal
COPY test test
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o kubevirt-redfish ./test/lab/kubevirt-redfish

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /workspace/kubevirt-redfish /kubevirt-redfish
USER 65532:65532
ENTRYPOINT ["/kubevirt-redfish"]
